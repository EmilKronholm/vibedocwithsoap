{
  "name": "folio2-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev -w examples/minimal",
    "dev:showcase": "npm run dev -w examples/showcase",
    "dev:web": "npm run dev -w examples/web-component",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
