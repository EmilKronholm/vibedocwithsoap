{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@folio/core": ["packages/core/src/index.ts"],
      "@folio/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "examples/*/src"]
}
